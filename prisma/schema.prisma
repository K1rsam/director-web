generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REVIEWER
  OPERATOR
}

enum AssetType {
  CH
  LOOK
  GROUP
  BEAST
  LOC
  PROP
  STYLE
  NEG
}

enum TaskPackageStatus {
  DRAFT
  READY
  RUNNING
  DONE
  FAILED
}

enum GenerationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ReviewRoundStatus {
  OPEN
  APPROVED
  CHANGES_REQUESTED
  CLOSED
}

enum WorkflowIssueSeverity {
  BLOCKER
  MAJOR
  MINOR
}

enum WorkflowIssueStatus {
  OPEN
  RESOLVED
  EXCEPTED
}

enum PromptSyncStatus {
  DRAFT_COMPILED
  RELEASE_COMPILED
  MANUAL_UNSYNCED
  STALE
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  username         String        @unique
  passwordHash     String
  name             String?
  failedLoginCount Int            @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  roles            ProjectRole[]
  sessions         Session[]
  providerCredentials UserProviderCredential[]
}

model UserProviderCredential {
  id               String   @id @default(cuid())
  userId           String
  provider         String   @default("DEEPSEEK")
  apiKeyCiphertext String
  apiKeyHint       String?
  apiBase          String   @default("https://api.deepseek.com")
  model            String   @default("deepseek-chat")
  lastTestedAt     DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, updatedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id              String          @id @default(cuid())
  title           String
  description     String?
  style           String?
  aspectRatio     String          @default("16:9")
  executionMode   String          @default("CLI")
  ruleVersion     String          @default("TASK_SCHEMA_V4")
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  episodes        Episode[]
  assets          Asset[]
  taskPackages    TaskPackage[]
  generationRuns  GenerationRun[]
  reviewRounds    ReviewRound[]
  finalScripts    FinalScript[]
  roles           ProjectRole[]
  sceneSnapshots  SceneSnapshot[]
  pipelineRuns    PipelineRun[]
  workflowIssues  WorkflowIssue[]
  cliRoleSessions     CliRoleSession[]
  apiRoleSessions     ApiRoleSession[]
  presentationContracts PresentationContract[]
}

model ProjectRole {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, role])
  @@index([projectId])
}

model Episode {
  id             String          @id @default(cuid())
  projectId      String
  number         Int
  title          String?
  content        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots      SceneSnapshot[]
  taskPackages   TaskPackage[]
  reviewRounds   ReviewRound[]
  finalScripts   FinalScript[]
  scriptScenes   ScriptScene[]
  storyboardShots StoryboardShot[]
  seedanceUnits  SeedanceUnit[]
  pipelineRuns   PipelineRun[]
  workflowIssues WorkflowIssue[]

  @@unique([projectId, number])
  @@index([projectId])
}

model ScriptScene {
  id               String           @id @default(cuid())
  episodeId        String
  sceneKey         String
  sortOrder        Int
  heading          String?
  location         String?
  interiorExterior String?
  timeOfDay        String?
  weather          String?
  timeLayer        String           @default("现实")
  sourceText       String
  metadata         String           @default("{}")
  revision         String           @default("V1")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  episode          Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  shots            StoryboardShot[]
  units            SeedanceUnit[]

  @@unique([episodeId, sceneKey])
  @@index([episodeId, sortOrder])
}

model StoryboardShot {
  id             String             @id @default(cuid())
  episodeId      String
  sceneId        String
  shotKey        String
  sortOrder      Int
  duration       Float
  timeLayer      String             @default("现实")
  sourceNodeRefs String             @default("[]")
  dialogue       String             @default("[]")
  e1Data         String             @default("{}")
  e2Data         String             @default("{}")
  e3Data         String             @default("{}")
  e4Data         String             @default("{}")
  revision       String             @default("V1")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  episode        Episode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  scene          ScriptScene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  unitLinks      SeedanceUnitShot[]
  issues         WorkflowIssue[]

  @@unique([episodeId, shotKey])
  @@index([sceneId, sortOrder])
}

model SeedanceUnit {
  id               String                  @id @default(cuid())
  episodeId        String
  sceneId          String
  unitKey          String
  sortOrder        Int
  duration         Float
  shortUnitReason  String?
  dominantGoal     String?
  startPremise     String
  endState         String
  data             String                  @default("{}")
  revision         String                  @default("V1")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  episode          Episode                 @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  scene            ScriptScene             @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shotLinks        SeedanceUnitShot[]
  promptVersions   CompiledPromptVersion[]
  issues           WorkflowIssue[]

  @@unique([episodeId, unitKey])
  @@index([sceneId, sortOrder])
}

model SeedanceUnitShot {
  id        String         @id @default(cuid())
  unitId    String
  shotId    String
  sortOrder Int
  unit      SeedanceUnit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  shot      StoryboardShot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@unique([unitId, shotId])
  @@index([unitId, sortOrder])
  @@index([shotId])
}

model CompiledPromptVersion {
  id          String           @id @default(cuid())
  unitId      String
  version     Int
  content     String
  syncStatus  PromptSyncStatus @default(DRAFT_COMPILED)
  selectedAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  unit        SeedanceUnit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, version])
  @@index([unitId, selectedAt])
}

model WorkflowIssue {
  id              String                @id @default(cuid())
  projectId       String
  episodeId       String
  shotId          String?
  unitId          String?
  coordinate      String
  code            String
  severity        WorkflowIssueSeverity
  status          WorkflowIssueStatus   @default(OPEN)
  ownerRole       String
  expected        String
  evidence        String
  requestedEffect String
  revision        String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode         Episode               @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  shot            StoryboardShot?       @relation(fields: [shotId], references: [id], onDelete: SetNull)
  unit            SeedanceUnit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([episodeId, status])
  @@index([shotId])
  @@index([unitId])
}

model PipelineRun {
  id            String              @id @default(cuid())
  projectId     String
  episodeId     String?
  stageCode     String
  roleName      String
  provider      String              @default("CLI")
  model         String?
  status        GenerationRunStatus @default(QUEUED)
  inputSummary  String?
  outputSummary String?
  log           String?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  durationMs    Int?
  createdAt     DateTime            @default(now())
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode       Episode?            @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([episodeId, stageCode])
}

model PresentationContract {
  id                    String   @id @default(cuid())
  projectId             String
  episodeId             String?
  category              String
  question              String
  options               String
  evidence              String?
  userAnswer            String?
  status                String   @default("PENDING")
  round                 Int      @default(1)
  note                  String?
  ruleKey               String?
  scopeMode             String   @default("SOURCE_EPISODES")
  targetEpisodeNumbers  String?
  decidedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model CliRoleSession {
  id              String   @id @default(cuid())
  projectId       String
  episodeId       String   @default("")
  stageCode       String
  sessionId       String
  model           String
  reasoningEffort String
  turnCount       Int      @default(0)
  inputChars      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, episodeId, stageCode])
  @@index([projectId, episodeId])
}

/** API 模式岗位会话：同集同岗位的调用历史（messages JSON），修复轮续接上下文 + DeepSeek prompt cache 命中省钱。 */
model ApiRoleSession {
  id         String   @id @default(cuid())
  projectId  String
  episodeId  String   @default("")
  stageCode  String
  model      String
  /** JSON 数组：[{role:"user"|"assistant", content}]，不含 system（每轮现取 skill 文本，天然命中缓存前缀） */
  messages   String
  turnCount  Int      @default(0)
  inputChars Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, episodeId, stageCode])
  @@index([projectId, episodeId])
}

model Asset {
  id            String    @id @default(cuid())
  projectId     String
  episodeId     String?
  code          String
  type          AssetType
  name          String
  status        String    @default("needs_confirmation")
  sourceText    String?
  notes         String?
  metadata      String?
  parentId      String?
  firstSeenNode String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Asset?    @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      Asset[]   @relation("AssetHierarchy")

  @@unique([projectId, code])
  @@index([projectId])
  @@index([episodeId])
  @@index([parentId])
}

model SceneSnapshot {
  id        String   @id @default(cuid())
  projectId String
  episodeId String?
  sceneKey  String?
  title     String?
  content   String
  metadata  String?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([episodeId])
  @@index([projectId, sceneKey, createdAt, id])
  @@index([sceneKey, createdAt, id])
}

model TaskPackage {
  id             String            @id @default(cuid())
  projectId      String
  episodeId      String?
  title          String
  brief          String?
  status         TaskPackageStatus @default(DRAFT)
  payload        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode        Episode?          @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  generationRuns GenerationRun[]

  @@index([projectId])
  @@index([episodeId])
}

model GenerationRun {
  id            String              @id @default(cuid())
  projectId     String
  taskPackageId String?
  provider      String?
  model         String?
  prompt        String?
  output        String?
  conversationUrl String?
  status        GenerationRunStatus @default(QUEUED)
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime            @default(now())
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskPackage   TaskPackage?        @relation(fields: [taskPackageId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskPackageId])
}

model ReviewRound {
  id        String            @id @default(cuid())
  projectId String
  episodeId String?
  title     String
  notes     String?
  status    ReviewRoundStatus @default(OPEN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode   Episode?          @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([episodeId])
}

model FinalScript {
  id        String   @id @default(cuid())
  projectId String
  episodeId String?
  version   Int      @default(1)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)

  @@unique([projectId, episodeId, version])
  @@index([projectId])
  @@index([episodeId])
}
