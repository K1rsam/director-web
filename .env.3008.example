# 复制为 .env 后填写本机私有值；此模板没有密钥或账号密码。
DATABASE_URL="file:./dev.db"
DIRECTOR_CREDENTIAL_KEY=""
TEST_ACCOUNT_INITIAL_PASSWORD=""

# 同主机不同端口共享 Cookie 域：3008 使用专用 Cookie 名和独立数据库。
DIRECTOR_SESSION_COOKIE_NAME="director_session_3008"

# 3008 CLI 当前由 role-runner 统一固定为 GPT-6.1 Sol / medium；以下值用于记录相同配置。
CLI_MODEL="gpt-6.1-sol"
CLI_REASONING_EFFORT="medium"
CLI_MODEL_F1="gpt-6.1-sol"
CLI_MODEL_F2="gpt-6.1-sol"
CLI_MODEL_Q1="gpt-6.1-sol"
CLI_REASONING_F1="medium"
CLI_REASONING_F2="medium"
CLI_REASONING_Q1="medium"
# CODEX_CLI_TIMEOUT_MS="1800000"

# 第三阶段单次新请求时限：未设置使用默认值；整数 1–3600000 ms（最多60分钟）。
# 无效值阻止新生成请求，历史仍可读；不改变旧回执，也不会自动继续或重跑。
# DIRECTOR_STORYBOARD_PLAN_TIMEOUT_MS="900000"
# DIRECTOR_STORYBOARD_AUTHOR_TIMEOUT_MS="1800000"
# DIRECTOR_STORYBOARD_FINISH_TIMEOUT_MS="1200000"

# Mac 默认使用 PATH 中的 codex、python3；不要复制 Windows 绝对路径。
# PYTHON="python3"
# Windows 可将上项改为 PYTHON="python"，或使用本机 Python 可执行文件的绝对路径。
# Windows 中文管道建议同时设置以下两项；必须使用 Python 3，不使用 Python 2。
# PYTHONUTF8="1"
# PYTHONIOENCODING="utf-8"
# CODEX_CLI_PATH="/absolute/path/to/codex"
# DIRECTOR_KNOWLEDGE_BASE_DIR="/absolute/path/to/director-knowledge"
# CODEX_SKILLS_DIR="/absolute/path/to/skills"

# 可选 API 模式；它不采用上面的 CLI 模型配置。
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com"
