# 复制为 .env 后填写本机私有值；此模板没有密钥或账号密码。
DATABASE_URL="file:./dev.db"
DIRECTOR_CREDENTIAL_KEY=""
TEST_ACCOUNT_INITIAL_PASSWORD=""

# 同主机不同端口共享 Cookie 域：3008 使用专用 Cookie 名和独立数据库。
DIRECTOR_SESSION_COOKIE_NAME="director_session_3008"

# 3008 CLI 当前由 role-runner 统一固定为 Terra / medium；以下值用于记录相同配置。
CLI_MODEL="gpt-5.6-terra"
CLI_REASONING_EFFORT="medium"
CLI_MODEL_F1="gpt-5.6-terra"
CLI_MODEL_F2="gpt-5.6-terra"
CLI_MODEL_Q1="gpt-5.6-terra"
CLI_REASONING_F1="medium"
CLI_REASONING_F2="medium"
CLI_REASONING_Q1="medium"
# CODEX_CLI_TIMEOUT_MS="1800000"

# Mac 默认使用 PATH 中的 codex、python3；不要复制 Windows 绝对路径。
# PYTHON="python3"
# CODEX_CLI_PATH="/absolute/path/to/codex"
# DIRECTOR_KNOWLEDGE_BASE_DIR="/absolute/path/to/director-knowledge"
# CODEX_SKILLS_DIR="/absolute/path/to/skills"

# 可选 API 模式；它不采用上面的 CLI 模型配置。
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com"
