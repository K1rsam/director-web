DATABASE_URL="file:./dev.db"
TEST_ACCOUNT_INITIAL_PASSWORD=""
# 仓库已内置导演规则；只有自定义规则库位置时才设置此项
# DIRECTOR_KNOWLEDGE_BASE_DIR="/absolute/path/to/director-knowledge"

# CLI 执行模式：默认 E0–E4 使用 gpt-5.6-terra/high，E5 使用 gpt-5.6-sol/high
# CLI_MODEL="gpt-5.6-terra"
# CLI_MODEL_E5="gpt-5.6-sol"
# CLI_REASONING_EFFORT="high"
# CLI_REASONING_E5="high"
# CODEX_CLI_TIMEOUT_MS="1800000"
# 仓库已内置岗位 Skill；只有自定义安装位置时才设置此项
# CODEX_SKILLS_DIR="/absolute/path/to/skills"

# API 执行模式（DeepSeek）：填入开放平台 Key 后，项目可在导入时或项目页切换为 API 执行
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com"
# 账号级 API Key 的服务端加密密钥；请使用随机的 32+ 字符值，绝不要提交真实密钥
DIRECTOR_CREDENTIAL_KEY=""
# 可选：覆盖模型、输出上限、思考模式和超时
# DEEPSEEK_API_MODEL="deepseek-chat"
# DEEPSEEK_API_MODEL_REASONER="deepseek-reasoner"
# DEEPSEEK_API_REASONER_STAGES="E1,E5"
# DEEPSEEK_API_MAX_TOKENS="8192"
# DEEPSEEK_API_THINKING="disabled"
# DEEPSEEK_API_REASONING_EFFORT="high"
# DEEPSEEK_API_TIMEOUT_MS="900000"
